# Copy this file to .env and fill in what you need:  cp .env.example .env
# .env is in .gitignore, so your keys never reach GitHub.

# ---------------------------------------------------------------------------
# Which model answers. Options: ollama | gemini | vertex | openai_compatible | fake
#   ollama  = free local models (install Ollama, then `ollama pull qwen2.5:7b`)
#   gemini  = Google AI Studio free tier (needs GEMINI_API_KEY below)
#   vertex  = Gemini on Google Cloud Vertex AI (week 12, uses free-trial credits)
#   fake    = offline test model, no install needed (answers are not smart)
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
CHAT_MODEL=qwen2.5:7b
# Smaller model for cheap jobs like classification. Use qwen2.5:3b on 8 GB RAM machines.
FAST_MODEL=qwen2.5:3b

OLLAMA_BASE_URL=http://localhost:11434/v1

# Free key from https://aistudio.google.com/apikey
# With LLM_PROVIDER=gemini, set CHAT_MODEL / FAST_MODEL to a current Gemini model name
# from AI Studio, for example gemini-2.5-flash and gemini-2.5-flash-lite.
GEMINI_API_KEY=

# Week 12, LLM_PROVIDER=vertex: Gemini on Google Cloud. No key: run
# `gcloud auth application-default login` and `uv sync --extra vertex`. See deploy/README.md.
VERTEX_PROJECT=
VERTEX_LOCATION=global

# Any other OpenAI-compatible endpoint (Azure OpenAI, Groq, ...)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings for document search. Keep these local even if you chat with Gemini.
# Changing the model or dimension means re-running the ingestion script.
# ---------------------------------------------------------------------------
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# nomic-embed-text was trained with these prefixes; set both empty for other models.
EMBED_QUERY_PREFIX="search_query: "
EMBED_DOCUMENT_PREFIX="search_document: "

# ---------------------------------------------------------------------------
# Retrieval (weeks 3-4). Try different settings and compare them with the eval suite.
# ---------------------------------------------------------------------------
# vector | keyword | hybrid
RETRIEVAL_MODE=hybrid
# Excerpts given to the model, and excerpts fetched before fusion and reranking.
TOP_K=4
CANDIDATES=20
# none | cross_encoder  (cross_encoder needs: uv sync --extra rerank)
RERANKER=none
# Below this similarity the bot says "I don't know" without calling the model.
# Tune it with the eval suite's abstain_ok and false_abstain metrics.
RAG_MIN_SIMILARITY=0.45
# Load data/docs automatically on startup when the knowledge base is empty.
AUTO_INGEST=true

# ---------------------------------------------------------------------------
# Agent (weeks 6-8)
# ---------------------------------------------------------------------------
# graph = LangGraph version, loop = the plain Python loop. Compare them with the agent eval.
AGENT_ENGINE=graph
# true = the ticket tools come from the MCP server (started automatically as a subprocess).
TICKETS_VIA_MCP=false
# Load the demo customers and invoices on startup when there are none.
AUTO_SEED=true

# ---------------------------------------------------------------------------
# Ticket classification router (week 11)
# ---------------------------------------------------------------------------
# Empty = FAST_MODEL. After fine-tuning (finetune/README.md) use supportpilot-router
# with the short prompt classify_ft.
CLASSIFY_MODEL=
CLASSIFY_PROMPT=classify

# ---------------------------------------------------------------------------
# Production (weeks 9-10)
# ---------------------------------------------------------------------------
# Reuse the answer to a first question that means the same as an earlier one.
CACHE_ENABLED=true
# How similar (cosine) two questions must be to share an answer. Lower = more hits, more risk.
CACHE_SIMILARITY=0.95
CACHE_TTL_HOURS=24
# true = also ask FAST_MODEL whether each message is a prompt-injection attempt.
GUARD_LLM=false
# Optional Langfuse tracing (self-host it for free, see README). Leave empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml; these are local-only passwords)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://supportpilot:supportpilot@localhost:5432/supportpilot

# Older messages are summarised once a conversation passes this many messages.
MEMORY_MAX_MESSAGES=12

# 0 = focused and repeatable, 1 = more varied.
TEMPERATURE=0.2

# Cost tracking, in USD per 1M tokens. 0 for local models. Put a hosted model's list
# price here to see what each conversation would cost in production.
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0

CORS_ORIGINS=http://localhost:3000
